# Example environment for the ERP backend. Copy to `.env` and fill in real
# values. NEVER commit real secrets.

NODE_ENV=development
PORT=4001

# Database — tenant DB + landlord DB
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_NAME=erp_db
DB_LANDLORD_NAME=erp_landlord

# Auth
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Frontend origin(s) for CORS. Comma-separated allow-list.
FRONTEND_URL=http://localhost:4000

# AI / Copilot (optional)
# ANTHROPIC_API_KEY=            # set to enable Kuza Copilot (/insights/ask)
# ENABLE_US_PAYROLL=true        # payroll runs are gated off by default (GTM D1)
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://model-runner.docker.internal/engines/v1
OLLAMA_MODEL=ai/llama3.2:latest
OLLAMA_TIMEOUT=30000

# Paystack (subscription checkouts). Never commit a real key.
PAYSTACK_SECRET_KEY=sk_test_replace_me

# Monnify (Moniepoint) — Payments module (Bank Transfer / virtual accounts).
MONNIFY_BASE_URL=https://sandbox.monnify.com
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=

# Error tracking. Leave empty to disable — Sentry is a no-op unless a DSN is set.
SENTRY_DSN=
