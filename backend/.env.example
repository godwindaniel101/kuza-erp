# Example environment for the ERP backend. Copy to `.env` and fill in real
# values. NEVER commit real secrets.

NODE_ENV=development
PORT=4001

# Database — tenant DB + landlord DB
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_NAME=erp_db
DB_LANDLORD_NAME=erp_landlord

# Auth
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Billing — length of the all-access free trial (days) before a tenant must pay.
TRIAL_DAYS=14

# Frontend origin(s) for CORS. Comma-separated allow-list.
FRONTEND_URL=http://localhost:5001

# Google OAuth (Sign in / Sign up with Google). Get these from the Google Cloud
# console; the callback URL must be an AUTHORIZED redirect URI there and match
# this value exactly. Unset → the Google button is effectively disabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4001/api/auth/google/callback

# Kuza AI Agents — channel connections
# Encryption key for channel credentials at rest (Meta long-lived tokens,
# Telegram bot tokens). Any string works — a stable 32-byte key is derived from
# it (SHA-256). REQUIRED before connecting WhatsApp/Instagram/Messenger/Telegram.
# Generate one with:  openssl rand -hex 32
KUZA_ENCRYPTION_KEY=change-me-to-a-long-random-secret
# Meta (Facebook Login) app for WhatsApp / Instagram / Messenger channels.
# Create the app in the Meta developer console; META_OAUTH_CALLBACK_URL must be
# an AUTHORIZED redirect URI there and match this value exactly.
META_APP_ID=
META_APP_SECRET=
META_OAUTH_CALLBACK_URL=http://localhost:4001/api/ai/channels/oauth/meta/callback

# AI / Copilot (optional)
# ANTHROPIC_API_KEY=            # set to enable Kuza Copilot (/insights/ask)
# ENABLE_US_PAYROLL=true        # payroll runs are gated off by default (GTM D1)
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://model-runner.docker.internal/engines/v1
OLLAMA_MODEL=ai/llama3.2:latest
OLLAMA_TIMEOUT=30000

# Paystack (subscription checkouts). Never commit a real key.
PAYSTACK_SECRET_KEY=sk_test_replace_me

# Monnify (Moniepoint) — Payments module (Bank Transfer / virtual accounts).
MONNIFY_BASE_URL=https://sandbox.monnify.com
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=

# Error tracking. Leave empty to disable — Sentry is a no-op unless a DSN is set.
SENTRY_DSN=

# ── Transactional email ───────────────────────────────────────────────────
# EMAIL_PROVIDER: smtp (nodemailer + Handlebars) | brevo (Brevo transactional
# API, with SMTP fallback for unmapped templates).
EMAIL_PROVIDER=smtp
# SMTP (used when EMAIL_PROVIDER=smtp, or as the Brevo fallback):
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=no-reply@kuza.app
MAIL_FROM_NAME=Kuza
# Brevo (required when EMAIL_PROVIDER=brevo). Sender must be verified in Brevo.
BREVO_API_KEY=
