<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>Your reservation at {{venueName}}</title>
</head>
<body style="font-family: Arial, Helvetica, sans-serif; color: #1f2937; background: #f6f7f9; margin: 0; padding: 24px;">
  <div style="max-width: 520px; margin: 0 auto; background: #ffffff; border-radius: 12px; overflow: hidden; border: 1px solid #e5e7eb;">
    <div style="background: #111827; color: #ffffff; padding: 20px 24px;">
      <div style="font-size: 18px; font-weight: 700;">{{venueName}}</div>
      <div style="font-size: 13px; opacity: .8;">Reservation {{statusLabel}}</div>
    </div>
    <div style="padding: 24px;">
      <p style="margin: 0 0 16px;">Hi {{customerName}},</p>
      <p style="margin: 0 0 16px;">{{intro}}</p>
      <table style="width: 100%; border-collapse: collapse; font-size: 14px;">
        <tr><td style="padding: 6px 0; color: #6b7280;">Date &amp; time</td><td style="padding: 6px 0; text-align: right; font-weight: 600;">{{dateTime}}</td></tr>
        <tr><td style="padding: 6px 0; color: #6b7280;">Party size</td><td style="padding: 6px 0; text-align: right; font-weight: 600;">{{partySize}}</td></tr>
        {{#if tableLabel}}<tr><td style="padding: 6px 0; color: #6b7280;">Table</td><td style="padding: 6px 0; text-align: right; font-weight: 600;">{{tableLabel}}</td></tr>{{/if}}
        {{#if reference}}<tr><td style="padding: 6px 0; color: #6b7280;">Reference</td><td style="padding: 6px 0; text-align: right; font-weight: 600;">{{reference}}</td></tr>{{/if}}
      </table>
      {{#if notes}}<p style="margin: 16px 0 0; font-size: 13px; color: #6b7280;">Notes: {{notes}}</p>{{/if}}
      <p style="margin: 20px 0 0; font-size: 13px; color: #6b7280;">If you need to change or cancel, just reply to this email or call the venue.</p>
    </div>
  </div>
</body>
</html>
