# Kuza backend origin (the API root is <KUZA_API_URL>/api).
KUZA_API_URL=http://localhost:3000

# Auth — choose ONE (checked in this order):
# (a) RECOMMENDED: a stable, revocable API token from Kuza → Settings → API.
#     Exchanged locally for a short-lived JWT and auto-refreshed; revoke it in
#     the UI to cut off access. Best for long-running / Claude Desktop setups.
KUZA_API_TOKEN=kuza_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# (b) or paste a Kuza JWT (from login / your browser session). Cannot be
#     refreshed — a long session may need a restart when it expires:
# KUZA_TOKEN=eyJhbGciOi...
# (c) or let the server log in for you (exchanged locally for a JWT):
# KUZA_EMAIL=owner@example.com
# KUZA_PASSWORD=your-password
