# Marketing website (Next.js). Copy to `.env`.
#
# NEXT_PUBLIC_APP_URL — the operator-portal origin the site redirects
# "Sign in" / "Start free" to. lib/site.ts turns it into LOGIN_URL / REGISTER_URL,
# and Nav / Footer / the hero CTAs link to those.
#
# IMPORTANT: NEXT_PUBLIC_* is BAKED INTO THE BUILD — it is NOT read at runtime.
#   - Local dev (`next dev`): read from this file / website/.env.
#   - Production: passed as a Docker build-arg by the deploy workflow
#     (.github/workflows/deploy.yml → `env: NEXT_PUBLIC_APP_URL`). Setting it as a
#     runtime env var on the Cloud Run service does NOTHING — you must change the
#     value in the workflow and let it rebuild the website image.
NODE_ENV=development
NEXT_TELEMETRY_DISABLED=1
NEXT_PUBLIC_APP_URL=http://localhost:5001
