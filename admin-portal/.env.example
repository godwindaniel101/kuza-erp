# admin-portal — super-admin console (Next.js). Copy to `.env`.
# NEXT_PUBLIC_* is baked into the browser bundle at build time (and read at
# runtime by `next dev`). In production the CI passes it as a Docker build-arg.

NODE_ENV=development
NEXT_TELEMETRY_DISABLED=1

# Backend API base — how the console (BROWSER) calls the backend.
NEXT_PUBLIC_API_URL=http://localhost:4001

# Server-side (SSR) backend base — optional; falls back to NEXT_PUBLIC_API_URL.
# In Docker use the compose service name (http://backend:4001); native uses localhost.
SSR_API_URL=http://localhost:4001
