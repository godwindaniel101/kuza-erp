# ─────────────────────────────────────────────────────────────────────────
# Kuza — environment overrides. Copy to `.env` (docker-compose reads it).
# Only set what you want to override; docker-compose.yml already has defaults.
# ─────────────────────────────────────────────────────────────────────────

# ═════════════════════════════ AI / LLM provider ══════════════════════════
# Switch the AI backend by config, not code. Pick ONE provider block.

# 1) LOCAL (default) — Docker Model Runner / Ollama / llama.cpp / LM Studio.
#    OpenAI-compatible /chat/completions. No API key required.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://model-runner.docker.internal/engines/v1
OLLAMA_MODEL=ai/llama3.2:latest
OLLAMA_TIMEOUT=30000
#    Using raw Ollama instead of Docker Model Runner?
#    OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
#    OLLAMA_MODEL=llama3.2

# 2) OpenAI / ChatGPT — set AI_PROVIDER=openai and provide a key.
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-proj-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# 3) Anthropic / Claude — set AI_PROVIDER=anthropic and provide a key.
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-api03-XXXXXXXXXXXXXXXXXXXXXXXXXXXX
# ANTHROPIC_MODEL=claude-sonnet-5

# ═══════════════════════════ other common overrides ═══════════════════════
# JWT_SECRET=change-me-in-production
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# NEXT_PUBLIC_API_URL=http://localhost:4001
# WEBSITE_PORT=8080
# KUZA_APP_URL=http://localhost:5001    # marketing-site "Sign in / Start free" target

# ═══════════════════════════ email / transactional mail ═══════════════════
# Choose the transactional-email backend. `smtp` (default) uses nodemailer +
# Handlebars templates; `brevo` routes mapped templates through the Brevo
# (Sendinblue) transactional API. Unmapped templates always fall back to SMTP.
# EMAIL_PROVIDER=smtp        # smtp | brevo

# SMTP (nodemailer) — used when EMAIL_PROVIDER=smtp (or as the Brevo fallback):
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_SECURE=false
# MAIL_USER=
# MAIL_PASSWORD=
# MAIL_FROM=no-reply@kuza.app
# MAIL_FROM_NAME=Kuza

# Brevo (Sendinblue) — required when EMAIL_PROVIDER=brevo:
# BREVO_API_KEY=
# BREVO_SENDER_EMAIL=            # falls back to MAIL_FROM
# BREVO_SENDER_NAME=            # falls back to MAIL_FROM_NAME

# Brevo template IDs — override the built-in defaults per template name:
# BREVO_TEMPLATE_WELCOME=1
# BREVO_TEMPLATE_INVITATION=2
# BREVO_TEMPLATE_PASSWORD_RESET=3
# BREVO_TEMPLATE_RESERVATION_CONFIRMATION=4
# BREVO_TEMPLATE_INVOICE=5
# BREVO_TEMPLATE_SUPPLIER_INVITE=6
# BREVO_TEMPLATE_PARTNERSHIP_REQUEST=7
