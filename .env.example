# ─────────────────────────────────────────────────────────────────────────
# Kuza — COMPOSE-LEVEL config for the local Docker stack ONLY.
#
# These values are interpolated into docker-compose.yml (${VAR}) to wire the
# topology: host ports, which Dockerfile to build, and the Postgres bootstrap
# credentials shared by the db container and the backend.
#
# App config + SECRETS live with each service, not here:
#   backend/.env       ← copy from backend/.env.example   (JWT, mail, AI, payments)
#   user-portal/.env   ← copy from user-portal/.env.example
#   admin-portal/.env  ← copy from admin-portal/.env.example
#
# Copy this file to `.env` and adjust. `.env` is gitignored — never commit it.
# ─────────────────────────────────────────────────────────────────────────

NODE_ENV=development

# ── Host port mappings (host side of host:container) ──────────────────────
DB_PORT=4433
BACKEND_PORT=4001
USER_PORTAL_PORT=5001
ADMIN_PORTAL_PORT=5002
WEBSITE_PORT=5003
OLLAMA_PORT=11434

# ── Which Dockerfile each service builds with ─────────────────────────────
# Dockerfile.dev = hot-reload dev image; Dockerfile = production build.
DOCKERFILE_BACKEND=Dockerfile.dev
DOCKERFILE_USER_PORTAL=Dockerfile.dev
DOCKERFILE_ADMIN_PORTAL=Dockerfile.dev
DOCKERFILE_WEBSITE=Dockerfile.dev

# ── Postgres bootstrap credentials ────────────────────────────────────────
# Used to INITIALISE the postgres container AND by the backend to connect to it
# inside the compose network. Keep the two in sync. Prod uses Secret Manager
# (see DEPLOY.md) — these are local-only.
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=erp_db
DB_LANDLORD_NAME=erp_landlord
# TypeORM auto-sync schema in dev. MUST be false in production.
DB_SYNCHRONIZE=true
