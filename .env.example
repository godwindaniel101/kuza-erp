# Kuza — COMPOSE TOPOLOGY ONLY for the local Docker stack.
# Host ports + which Dockerfile each service builds with. There are NO app env
# vars in docker-compose.yml — each service owns its config in its own .env:
#   backend/.env         (copy from backend/.env.example)
#   user-portal/.env     (copy from user-portal/.env.example)
#   admin-portal/.env    (copy from admin-portal/.env.example)
#   website/.env         (copy from website/.env.example)
#   docker/postgres/.env (copy from docker/postgres/.env.example)
# Copy this file to `.env`. `.env` is gitignored — never commit it.

# Host port mappings (host:container)
DB_PORT=4433
BACKEND_PORT=4001
USER_PORTAL_PORT=5001
ADMIN_PORTAL_PORT=5002
WEBSITE_PORT=5003
OLLAMA_PORT=11434

# Dockerfile.dev = hot-reload dev image; Dockerfile = production build.
DOCKERFILE_BACKEND=Dockerfile.dev
DOCKERFILE_USER_PORTAL=Dockerfile.dev
DOCKERFILE_ADMIN_PORTAL=Dockerfile.dev
DOCKERFILE_WEBSITE=Dockerfile.dev
