# terraform.tfvars.example
# Copy to terraform.tfvars and adjust. Contains NON-SECRET values only.
# Real secret values (DB password, JWT secret, mailer/Monnify keys) are NOT set here —
# see the README ("Supplying secrets"). Do NOT commit terraform.tfvars.

region      = "us-east-1"
project     = "kuza-erp"
environment = "prod"

# --- Networking ---
vpc_cidr           = "10.0.0.0/16"
az_count           = 2
single_nat_gateway = true # set false for one NAT per AZ (HA, higher cost)

# --- Container images (tags in ECR; push images before apply completes healthy) ---
backend_image_tag  = "latest"
frontend_image_tag = "latest"

# --- ECS sizing ---
backend_cpu            = 512
backend_memory         = 1024
backend_desired_count  = 2
frontend_cpu           = 256
frontend_memory        = 512
frontend_desired_count = 2

# --- RDS ---
db_instance_class        = "db.t4g.micro"
db_engine_version        = "15.7"
db_allocated_storage     = 20
db_max_allocated_storage = 100
db_username              = "erp_admin"
db_landlord_name         = "erp_landlord"
db_app_name              = "erp_db"
db_multi_az              = false # set true for prod HA
db_deletion_protection   = true

# --- App config ---
node_env    = "production"
ai_provider = "openai" # ollama | openai | anthropic

# --- TLS / DNS (optional) ---
# Provide an ACM cert ARN (in the same region as the ALB) to enable HTTPS:443 + HTTP->HTTPS
# redirect. Provide the domain to build correct public URLs for the app.
# certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
# domain_name     = "app.example.com"
