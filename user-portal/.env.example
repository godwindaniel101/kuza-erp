# user-portal — operator dashboard (Next.js). Copy to `.env`.
# NEXT_PUBLIC_* is baked into the browser bundle at build time (and read at
# runtime by `next dev`). In production the CI passes it as a Docker build-arg.

NODE_ENV=development
NEXT_TELEMETRY_DISABLED=1

# Backend API base — how the portal (BROWSER) calls the backend. Must be a URL
# the browser can reach. Read by lib/api.ts and lib/format.ts.
NEXT_PUBLIC_API_URL=http://localhost:4001

# Server-side (SSR) backend base — used inside the container/server for the
# public menu site. Optional; falls back to NEXT_PUBLIC_API_URL. In Docker set
# the compose service name (http://backend:4001); native dev uses localhost.
SSR_API_URL=http://localhost:4001

# Public absolute base for the published QR menu site (pages/m/[slug]) — used to
# build shareable / QR links. Falls back to the request host if unset.
NEXT_PUBLIC_SITE_URL=http://localhost:5001
