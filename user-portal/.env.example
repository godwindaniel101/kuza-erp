# user-portal — operator dashboard (Next.js). Copy to `.env`.
# NEXT_PUBLIC_* is baked into the client bundle at build time (and read at
# runtime in dev). In production it is passed as a Docker build-arg (see the CI
# workflow); this file is for local Docker / `next dev`.
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:4001
NEXT_TELEMETRY_DISABLED=1
